# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Standalone executable binaries (downloaded via setup.sh)
bin/tor
bin/snowflake-client
bin/lyrebird
bin/obfs4proxy

# Active runtime configuration and pid files
torrc
.tor.pid
.http_bridge.pid

# Session cache and logs (keep folder structure)
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep

# OS and Editor metadata
.DS_Store
.vscode/
.idea/
*.swp
